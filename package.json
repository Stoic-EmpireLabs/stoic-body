  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/quality/node_modules/eslint/bin/eslint.js src/core tests/core tests/pilot apps/local-pilot scripts/verify-core.ts scripts/test-local-pilot.ts scripts/test-health-pilot.ts scripts/test-learning-pilot.ts scripts/build-desktop.mjs scripts/test-desktop.mjs --max-warnings 0",
    "pilot": "node --import tsx apps/local-pilot/main.ts",
    "test:pilot": "node --import tsx scripts/test-local-pilot.ts",
    "test:health": "node --import tsx scripts/test-health-pilot.ts",
    "test:learning": "node --import tsx scripts/test-learning-pilot.ts",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
